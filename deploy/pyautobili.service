[Unit]
Description=pyAutobili 每日任务（B 站轻量级浏览器模拟）
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# 按实际部署路径与用户修改
WorkingDirectory=/opt/pyAutobili
ExecStart=/opt/pyAutobili/.venv/bin/python /opt/pyAutobili/main.py
User=ubuntu
Environment=PYTHONUNBUFFERED=1
# Cookie 也可改由 EnvironmentFile 提供：
# EnvironmentFile=/etc/pyAutobili.env   # 内容: BILI_COOKIE=SESSDATA=...; bili_jct=...
